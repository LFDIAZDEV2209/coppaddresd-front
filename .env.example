# Configuración de entorno para el frontend de CoppAddresd.
# Copia este archivo a `.env.local` y ajusta los valores.

# URL única del API Gateway (YARP). El gateway enruta por prefijo de path a
# los microservicios: /api/auth/* → Auth, /api/v1/* → Api, /api/v1/telemedicine/* → Telemedicina.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5080

# Minutos de inactividad antes de cerrar la sesión (default: 30)
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30

# Código de aplicación que identifica este cliente ante el Auth Service
# ("erp" para el frontend administrativo, "app" para la móvil)
NEXT_PUBLIC_APPLICATION_CODE=erp

# URL base del servicio de Comunidad (GraphQL). El endpoint HTTP es
# ${NEXT_PUBLIC_COMMUNITY_API_URL}/api/v1/community/graphql y las
# suscripciones WS en ${NEXT_PUBLIC_COMMUNITY_API_URL}/api/v1/community/subscriptions.
NEXT_PUBLIC_COMMUNITY_API_URL=http://localhost:5200
