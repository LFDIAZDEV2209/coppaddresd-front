# ConfiguraciÃ³n de entorno para el frontend de CoppAddresd.
# Copia este archivo a `.env.local` y ajusta los valores.

# URL Ãºnica del API Gateway (YARP). El gateway enruta por prefijo de path a
# los microservicios: /api/auth/* â†’ Auth, /api/v1/* â†’ Api, /api/v1/telemedicine/* â†’ Telemedicina.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5080

# Minutos de inactividad antes de cerrar la sesiÃ³n (default: 30)
NEXT_PUBLIC_SESSION_IDLE_MINUTES=30

# CÃ³digo de aplicaciÃ³n que identifica este cliente ante el Auth Service
# ("erp" para el frontend administrativo, "app" para la mÃ³vil)
NEXT_PUBLIC_APPLICATION_CODE=erp

# Override opcional del servicio de Comunidad (GraphQL). Por defecto se
# consume a través del gateway (NEXT_PUBLIC_GATEWAY_URL, rutas /api/v1/community
# y /storage); definir solo para entornos sin gateway.
NEXT_PUBLIC_COMMUNITY_API_URL=http://localhost:5080
