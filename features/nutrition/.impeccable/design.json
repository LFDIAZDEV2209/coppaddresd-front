      "html": "<button class=\"ds-button ds-primary\">Aprobar plan</button>",
      "css": ".ds-button{font-family:var(--font-plex),sans-serif;font-size:14px;color:var(--foreground,#1a1d2e);display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 10px;border:1px solid transparent;border-radius:12px;font-weight:500;white-space:normal;transition:all 200ms;cursor:pointer}.ds-button:focus-visible{outline:2px solid var(--ring,#023467);outline-offset:3px;}.ds-button:active{transform:translateY(1px)}.ds-button:disabled{background:var(--muted,#e2e8f0);color:var(--muted-foreground,#475569);border-color:var(--border,#e2e8f0);cursor:not-allowed;transform:none;box-shadow:none}.ds-primary{background:var(--nutrition-action-background,var(--brand-navy-deep,#023467));color:var(--nutrition-action-foreground,#fff)}.ds-primary:hover{background:color-mix(in srgb,var(--nutrition-action-background,var(--brand-navy-deep,#023467)) 90%,black);box-shadow:0 1px 3px #0000001a}:host-context(.dark) .ds-primary{background:var(--nutrition-action-background,#7dd3fc);color:var(--nutrition-action-foreground,#082f49)}",
      "refersTo": "button-primary"
    },
