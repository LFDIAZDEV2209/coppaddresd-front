{
  // coppaddresd-front (Next.js 16) — project config autocontenido.
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "../AGENTS.md",
    "../LEARNINGS.md",
    "../.agents/rules/*.md",
  ],
  "skills": {
    "paths": ["./.agents/skills", "../.agents/skills"],
  },
  "permission": {
    "skill": {
      "*": "allow",
    },
    "bash": {
      "yarn lint*": "allow",
      "yarn build*": "allow",
      "yarn dev*": "allow",
      "yarn i18n:check": "allow",
      "yarn i18n:apply": "ask",
      "npx tsc*": "allow",
    },
    "lsp": "allow",
  },
  "agent": {
    "coppaddresd": {
      "description": "Agente principal frontend: Next.js 16, diseño experto, skills-first",
      "mode": "primary",
      "prompt": "Eres el agente principal del frontend CoppAddresd (Next.js 16 + React 19 + Tailwind 4 + shadcn/Base UI). Aplica .agents/rules/*.md: ante UI carga design-taste-frontend + impeccable + frontend-design + react-best-practices + next-best-practices ANTES de codificar; Next.js 16 difiere de training data: lee node_modules/next/dist/docs/ para APIs nuevas; shadcn sobre Base UI (no Radix); Server Components por defecto; t() + yarn i18n:check; skeletons > spinners; verifica con yarn lint && npx tsc --noEmit y Playwright MCP visual. Responde en el idioma del usuario; docs en español.",
      "permission": {
        "skill": {
          "*": "allow",
        },
      },
    },
    "design-expert": {
      "description": "Diseñador UX/UI senior web: design systems, anti-slop, pre-flight",
      "mode": "subagent",
      "prompt": "Diseñador UX/UI senior web. Carga design-taste-frontend + impeccable + frontend-design + tailwind-css-patterns + shadcn + composition-patterns + accessibility + seo según aplique. Brief inference, locks, bans anti-slop, hero discipline, pre-flight impeccable detect. Verifica con Playwright MCP (desktop + mobile).",
    },
    "reviewer": {
      "description": "Revisor Next.js/React sin editar",
      "mode": "subagent",
      "prompt": "Revisor Next.js/React senior. Analiza sin editar: límites RSC, composición vs prop drilling, caché Next 16, accesibilidad, i18n, rendimiento. Cita archivo:línea.",
      "permission": {
        "edit": "deny",
      },
    },
  },
  "subagent_depth": 2,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000,
  },
  "lsp": true,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".jsonc",
        ".md",
        ".yaml",
        ".yml",
        ".html",
        ".css",
      ],
    },
  },
}
